# 部署目标配置（复制为 .env.deploy，勿提交到 git）
#
#   cp .env.deploy.example .env.deploy

# SSH 连接
DEPLOY_REMOTE_USER=your-ssh-user
DEPLOY_REMOTE_HOST=your-server.example.com

# 公网访问地址（用于健康检查提示、CORS 等）
DEPLOY_PUBLIC_URL=https://your-domain.example.com

# 远程路径（可按需覆盖默认值）
# DEPLOY_BACKEND_REMOTE_PATH=/home/josie/apps/family-bills-backend
# DEPLOY_FRONTEND_REMOTE_PATH=/var/www/family-bills-frontend

# systemd 服务名
# DEPLOY_SERVICE_NAME=family-bills-backend
